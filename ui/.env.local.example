# Copy to .env.local and fill in values for your environment.

# Lightnet (default)
NEXT_PUBLIC_MINA_ENDPOINT=http://127.0.0.1:8080/graphql
NEXT_PUBLIC_ARCHIVE_ENDPOINT=http://127.0.0.1:8282
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_MINA_NETWORK=testnet
NEXT_PUBLIC_BLOCK_EXPLORER_URL=http://localhost:5001

# Devnet
# NEXT_PUBLIC_MINA_ENDPOINT=https://api.minascan.io/node/devnet/v1/graphql
# NEXT_PUBLIC_ARCHIVE_ENDPOINT=https://api.minascan.io/archive/devnet/v1/graphql
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Offline CLI download source — required for the CLI download links to appear.
# No default on purpose: releases/latest is repo-wide (desktop releases share
# it), and the right release is per-deployment — pin the one whose
# minaguard-vk-hash.txt matches the deployed contracts. When unset, the UI
# shows setup guidance instead of a download link.
# NEXT_PUBLIC_OFFLINE_CLI_RELEASE_URL=https://github.com/zksecurity/mina-guard/releases/download/offline-cli-v0.1.0

# Expected MinaGuard verification-key hash. The worker compares what
# MinaGuard.compile() produces against this and refuses to proceed on a
# mismatch, so a poisoned IndexedDB compile cache cannot substitute the key that
# zkApp.deploy() installs on-chain. Same value the backend gets as
# MINAGUARD_VK_HASH: `contracts/scripts/read-vk-hash.sh <network>`, for the
# network in NEXT_PUBLIC_MINA_NETWORK_DOMAIN (unset there ⇒ testnet).
# Unset ⇒ check skipped, matching the backend. Set it in production; a stale
# value blocks every compile, so it must be regenerated with the circuit.
# NEXT_PUBLIC_MINAGUARD_VK_HASH=

# Enable e2e test helpers (NEVER set in production)
# NEXT_PUBLIC_E2E_TEST=true
